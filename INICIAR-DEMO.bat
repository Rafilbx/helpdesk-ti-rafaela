@echo off
REM Iniciar o HelpDesk TI em modo local, sem Docker.
set "ROOT=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$root = (Resolve-Path '%~dp0').Path; $ports = @(8001,8002,8003,8000); $commands = @(@{Port=8001; Name='Usuarios'; Env='$env:PYTHONPATH=(Join-Path $root ''services\shared''); $env:JWT_SECRET_KEY=''chave-local-de-teste-com-mais-de-32-caracteres''; Set-Location (Join-Path $root ''services\users''); & (Join-Path $root ''.venv\Scripts\python.exe'') -m uvicorn main:app --reload --port 8001'},@{Port=8002; Name='Inventario'; Env='$env:PYTHONPATH=(Join-Path $root ''services\shared''); $env:JWT_SECRET_KEY=''chave-local-de-teste-com-mais-de-32-caracteres''; Set-Location (Join-Path $root ''services\inventory''); & (Join-Path $root ''.venv\Scripts\python.exe'') -m uvicorn main:app --reload --port 8002'},@{Port=8003; Name='Chamados'; Env='$env:PYTHONPATH=(Join-Path $root ''services\shared''); $env:JWT_SECRET_KEY=''chave-local-de-teste-com-mais-de-32-caracteres''; $env:INVENTORY_URL=''http://127.0.0.1:8002''; $env:USERS_URL=''http://127.0.0.1:8001''; Set-Location (Join-Path $root ''services\tickets''); & (Join-Path $root ''.venv\Scripts\python.exe'') -m uvicorn main:app --reload --port 8003'},@{Port=8000; Name='Gateway'; Env='$env:USERS_URL=''http://127.0.0.1:8001''; $env:INVENTORY_URL=''http://127.0.0.1:8002''; $env:TICKETS_URL=''http://127.0.0.1:8003''; Set-Location (Join-Path $root ''gateway''); & (Join-Path $root ''.venv\Scripts\python.exe'') -m uvicorn main:app --reload --port 8000'}); foreach($item in $commands){ $busy=Get-NetTCPConnection -LocalPort $item.Port -State Listen -ErrorAction SilentlyContinue; if(-not $busy){ $cmd=$item.Env; Start-Process powershell -ArgumentList '-NoExit','-NoProfile','-Command',('$root='''+$root+'''; '+$cmd) } }; $ready=$false; for($i=0;$i -lt 40;$i++){ try{ Invoke-RestMethod 'http://127.0.0.1:8000/health' -TimeoutSec 2 | Out-Null; $ready=$true; break }catch{ Start-Sleep -Seconds 2 } }; if(-not $ready){ Write-Host 'Gateway ainda não respondeu. Confira as janelas dos serviços.'; exit 1 }; & (Join-Path $root '.venv\Scripts\python.exe') (Join-Path $root 'demo_data.py'); if($LASTEXITCODE -eq 0){ Start-Process 'http://localhost:8000/' }"
